_.ERASE _ALL
 
_.PLINE 0,0 50,0 50,50 0,50 _C
HGR
_W
-5,-5
55,55

0.3
(setq ss (ssget "X" '((0 . "CIRCLE"))))
(if ss
  (progn
    (setq n (sslength ss))
    (princ (strcat "\nHGR-RECT: Circles=" (itoa n)))
    (if (> n 0)
      (princ "\n>>> TEST_PASSED: circles generated")
      (princ "\n>>> TEST_FAILED: no circles")
    )
  )
  (princ "\n>>> TEST_FAILED: no circles found")
)

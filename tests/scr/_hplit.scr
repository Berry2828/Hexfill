_.NETLOAD
"C:/Users/allen/Desktop/HexFill_20260712_142407.dll"
_.ERASE
_ALL

_.PLINE
0,0
100,0
100,100
0,100
_C
HPLIT
_W
-10,-10
110,110

50,-10
50,110
(setq f (open "C:/Users/allen/Documents/Hexfill 2/tests/scr/result_hplit.log" "w"))
(setq ss (ssget "X" (list (cons 0 "LWPOLYLINE"))))
(if ss
  (progn
    (setq n (sslength ss))
    (write-line (strcat "HPLIT-RECT polylines=" (itoa n)) f)
    (if (= n 2)
      (write-line "PASS" f)
      (write-line (strcat "FAIL expected=2 got=" (itoa n)) f)
    )
  )
  (write-line "FAIL no-polylines" f)
)
(close f)

_.QUIT
_Y
